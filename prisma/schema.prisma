// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------
// Existing Models (Blog, Cookbook, Settings)
// -----------------------------------------

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// A pool of API keys per LLM provider. Tools that call a provider pick one at
// random from its active keys (see src/lib/api-keys.ts) so free-tier per-key
// rate limits are spread across the pool instead of exhausting a single key.
model ApiKey {
  id        String   @id @default(cuid())
  provider  String // "gemini" | "grok" | "openai" | "claude"
  key       String
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Null = a platform key (managed in admin). Set = a customer's own key (bring-your-own-keys plan).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, isActive])
  @@index([userId, provider])
}

// A bring-your-own-keys customer's model settings: whether their keys are used, and the priority order.
model UserModelConfig {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  useOwnKeys       Boolean  @default(false)
  // JSON string arrays, same shape as the platform AI_MODEL_ORDER / OPENROUTER_SELECTED_MODELS settings.
  order            String?
  openRouterModels String?
  updatedAt        DateTime @updatedAt
}

// One row per actual outbound call to a provider key (i.e. one row per key
// tried during callWithKeyRotation's retry loop) — the finest-grained record
// of real API traffic, used for the admin usage/failure dashboard.
model ApiCallLog {
  id           String   @id @default(cuid())
  provider     String
  model        String
  tool         String
  success      Boolean
  statusCode   Int?
  errorMessage String?
  // True when the call used a customer's own key — kept out of the admin platform analytics.
  ownKey       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([provider, createdAt])
  @@index([success, createdAt])
}

// One row per outbound SMTP send attempt (activation, password reset, plan change, ...) —
// used by the admin email dashboard to verify delivery, since sendMail() is otherwise fire-and-forget.
model EmailLog {
  id           String   @id @default(cuid())
  type         String // "activation" | "password-reset" | "plan-change"
  to           String
  subject      String
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([success, createdAt])
}

// subjectKey identifies who is being rate-limited: "user:<id>" for a signed-in
// user (so their quota follows their account, not their network), else "ip:<hash>".
model ToolUsageDaily {
  id         String   @id @default(cuid())
  subjectKey String
  tool       String
  date       String // YYYY-MM-DD (UTC)
  count      Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([subjectKey, tool, date])
}

// A parsed + chunked + embedded upload, kept around so the same visitor can
// run more than one prompt against it without re-uploading (and re-paying
// for) the document. Scoped to the uploading subject; lazily expired.
model ExtractedDocument {
  id          String   @id @default(cuid())
  subjectKey  String
  filename    String
  totalTokens Int
  createdAt   DateTime @default(now())

  chunks ExtractedDocumentChunk[]

  @@index([subjectKey, createdAt])
}

model ExtractedDocumentChunk {
  id         String            @id @default(cuid())
  documentId String
  document   ExtractedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  position  Int
  section   String
  content   String @db.Text
  embedding Json // number[]

  @@index([documentId])
}

enum BlogPostStatus {
  draft
  published
}

model BlogPost {
  id        String  @id @default(cuid())
  title     String
  slug      String  @unique
  content   String  @db.Text
  excerpt   String? @db.Text
  // Legacy flag, mirrored from `status` on every write. Public visibility is decided by status + publishedAt.
  published Boolean @default(false)

  seoTitle String?
  seoDesc  String?

  // Posts pushed from the portfolio site (POST /api/blog-posts). Null for posts created here.
  externalId     Int?           @unique
  imageUrl       String?        @db.Text
  sourceImageUrl String?        @db.Text
  canonicalUrl   String?        @db.Text
  status         BlogPostStatus @default(draft)
  publishedAt    DateTime?
  // Derived from the body when a post is saved, so list pages never have to load the (large) body.
  readingMinutes Int            @default(1)
  teaser         String?        @db.Text

  categories BlogCategory[]
  tags       BlogTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

model BlogCategory {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model BlogTag {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model CookbookCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text

  parentId String?
  parent   CookbookCategory?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children CookbookCategory[] @relation("CategoryToCategory")

  prompts CookbookPrompt[]
}

model CookbookPrompt {
  id         String           @id @default(cuid())
  // ID assigned by the automation that publishes via POST /api/cookbook-prompts; makes retries idempotent.
  externalId Int?             @unique
  title      String
  slug       String           @unique
  image      String?
  categoryId String
  category   CookbookCategory @relation(fields: [categoryId], references: [id])

  explanation    String @db.Text
  whenToUse      String @db.Text
  commonMistakes String @db.Text
  bestPractices  String @db.Text

  promptTemplate String @db.Text
  exampleInput   String @db.Text
  exampleOutput  String @db.Text

  faqs String? @db.Text

  published Boolean @default(false)

  seoTitle String?
  seoDesc  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------
// NextAuth Models
// -----------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  roles         Role[]    @relation("UserRoles")
  isActive      Boolean   @default(false) // For magic link activation
  createdAt     DateTime  @default(now())

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  // The one login (JWT "sid") currently allowed to act as this user; see src/lib/auth.ts.
  activeSessionId String?

  apiKeys     ApiKey[]
  modelConfig UserModelConfig?

  workspaceMemberships WorkspaceMember[]
  sentInvites          WorkspaceInvite[]
  savedPrompts         SavedPrompt[]

  accounts            Account[]
  sessions            Session[]
  workspaces          Workspace[]
  prompts             Prompt[]
  activationTokens    ActivationToken[]
  passwordResetTokens PasswordResetToken[]
  toolRuns            ToolRun[]

  @@index([planId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[] @relation("UserRoles")
}

model ActivationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// A subscription tier: no payment processor wired up yet, so a plan is purely an
// admin-assigned label that carries its own per-tool daily limits. Assigning a
// plan to a user (see admin/users) is how they get higher (or custom) limits
// instead of the flat authenticated default.
model Plan {
  id                     String   @id @default(cuid())
  name                   String   @unique
  slug                   String   @unique
  description            String?
  priceMonthlyCents      Int      @default(0)
  isDefault              Boolean  @default(false)
  isActive               Boolean  @default(true)
  // Shown on the public /pricing page: one feature per line, and whether to highlight the tier.
  features               String?  @db.Text
  isFeatured             Boolean  @default(false)
  // How many saved runs per tool this plan keeps in the user's dashboard history (oldest are dropped).
  historyPerTool         Int      @default(20)
  // Bring-your-own-keys plan: its users manage their own provider keys in the dashboard (/dashboard/models).
  allowsOwnKeys          Boolean  @default(false)
  // Every other plan allows one signed-in browser at a time; a newer login signs the older one out.
  allowsMultipleSessions Boolean  @default(false)
  // How many people (including the manager) a team workspace on this plan can hold. 0 = the plan can't create a team.
  maxSeats               Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  users  User[]
  limits PlanToolLimit[]
}

// One saved run of a tool for a signed-in user: what they entered and what they got back.
// Shown in the dashboard's tool history, where a run can be reopened in its tool (with the saved
// result on screen, no new submission), edited and re-run, or deleted. Anonymous runs are never saved.
model ToolRun {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      String // URL slug of the tool, e.g. "prompt-optimizer" (see src/lib/history.ts)
  title     String
  input     Json
  result    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, tool, updatedAt])
  @@index([userId, createdAt])
}

// A message submitted through the public /contact form.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  plan      String? // slug of the plan the sender was asking about, if they came from /pricing
  isRead    Boolean  @default(false)
  emailSent Boolean  @default(false) // whether the notification email to the team went out
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@index([email, createdAt])
}

// One row per tool a plan overrides the default authenticated daily limit for.
// A tool the plan doesn't list falls back to that tool's normal authenticated limit.
model PlanToolLimit {
  id         String @id @default(cuid())
  planId     String
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  tool       String
  dailyLimit Int

  @@unique([planId, tool])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------
// App Data Models (Cuelara Pro)
// -----------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // "personal" (one per user, private) or "team" (shared; `userId` is the owner/manager).
  type String @default("personal")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  prompts      Prompt[]
  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  savedPrompts SavedPrompt[]

  @@index([userId, type])
}

// Who belongs to a workspace and in what role: OWNER (the team manager), ADMIN (can invite and remove members) or MEMBER.
model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER")
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

// An emailed invitation to join a team workspace. The token in the link is the only credential, so it is single-use and expires.
model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("MEMBER")
  token       String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, email])
}

// A prompt saved to a workspace's library (private personal library, or shared with a team). Deliberately separate from
// `Prompt`, which the admin Prompts page lists — user libraries must never show up there.
model SavedPrompt {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  content     String    @db.Text
  tags        String[]
  // The tool it was saved from, e.g. "prompt-builder"; null when written by hand.
  sourceTool  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, updatedAt])
}

model Prompt {
  id       String   @id @default(cuid())
  title    String
  image    String? // Featured image URL
  content  String   @db.Text
  model    String?
  tokens   Int?
  cost     Float? // Added based on user feedback
  isPublic Boolean  @default(false) // Added based on user feedback
  tags     String[] // Added based on user feedback

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
}

// Fixed-window counters for abuse limits on public endpoints (login, register, password reset, contact).
// `key` already encodes the scope, the subject (hashed IP / email) and the window start, so one row = one bucket.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// Application errors, grouped by fingerprint (same failure = one row, `count` goes up) — see src/lib/error-report.ts.
// Shown on /admin/errors; a new fingerprint also emails the team.
model ErrorLog {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  source      String // "server" | "api" | "client"
  message     String   @db.Text
  stack       String?  @db.Text
  route       String?
  count       Int      @default(1)
  resolved    Boolean  @default(false)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([resolved, lastSeenAt])
}
