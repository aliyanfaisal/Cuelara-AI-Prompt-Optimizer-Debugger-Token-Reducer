# Copy to .env and fill in. Never commit real values.

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Public site URL (used by NextAuth and as the base of post URLs returned by the blog sync API)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

GEMINI_API_KEY=

# Shared secret the portfolio site (Laravel) sends as `Authorization: Bearer <token>` to POST /api/blog-posts.
# Generate one with: openssl rand -hex 32
# If this is unset, the endpoint rejects every request (fails closed). Set the same value in the Laravel app.
PORTFOLIO_API_TOKEN=

# Site to Prompt: Chrome Web Store URL of the Cuelara extension (shows the "Add to Chrome" button)
NEXT_PUBLIC_EXTENSION_URL=

# SMTP — sends account emails (activation, password reset, plan changes) via your own mailbox.
# cPanel/Zoho/Titan-style business email typically uses mail.<yourdomain>, port 465, SMTP_SECURE=true.
# Port 587 (STARTTLS) providers should set SMTP_SECURE=false.
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourdomain.com
SMTP_PASS=
# Optional — defaults to SMTP_USER for both if unset.
SMTP_FROM_EMAIL=you@yourdomain.com
SMTP_FROM_NAME=Cuelara

# Optional — where /contact form messages are emailed. Defaults to SMTP_FROM_EMAIL, then SMTP_USER.
CONTACT_TO_EMAIL=

# Optional — Google Indexing API. Pings Google when a blog post or cookbook prompt is published, updated or removed.
# Use a service account with the Indexing API enabled, and add its email as an Owner in Search Console.
# Point at the service account's JSON key file (keep it outside the web root and out of git):
GOOGLE_INDEXING_CREDENTIALS=
# ...or set the two fields from that file directly (private_key on one line with literal \n sequences):
# GOOGLE_INDEXING_CLIENT_EMAIL=
# GOOGLE_INDEXING_PRIVATE_KEY=
