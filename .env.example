# Copy to .env and fill in. Never commit real values.

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Public site URL (used by NextAuth and as the base of post URLs returned by the blog sync API)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

GEMINI_API_KEY=

# Shared secret the portfolio site (Laravel) sends as `Authorization: Bearer <token>` to POST /api/blog-posts.
# Generate one with: openssl rand -hex 32
# If this is unset, the endpoint rejects every request (fails closed). Set the same value in the Laravel app.
PORTFOLIO_API_TOKEN=
